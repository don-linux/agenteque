{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "outDir": "node_modules/.tsc/node"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ],
  // Los tests unitarios ejercitan módulos del renderer: necesitan DOM y el
  // alias `$lib`, así que los comprueba el proyecto web.
  "exclude": ["tests/unit/**/*.ts"]
}
